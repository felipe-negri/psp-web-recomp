     AddS, SubS, MulS, DivS, SqrtS, AbsS, MovS, NegS,
     RoundWS, TruncWS, CeilWS, FloorWS, CvtWS, CvtSW, FpuCompare,
     Bc1f, Bc1t, Bc1fl, Bc1tl, Bvf, Bvt, Bvfl, Bvtl,
-    Mfv, Mtv, Vpfx, Viim, Vfim, Vh2f, Vf2h, Vf2i, Vi2f, Vx2i, VmidT, Vmmov, VfpuMatrixInit, Vidt, Vcst, Vocp, VfpuHorizontal, Vrot, Vtfm, VfpuVectorInit, VfpuVec3, Vscl, Vdot, Vhdp, Vcmp, Vminmax, VfpuCompare3, Vcmov, VfpuUnary, Vmmul, Vmscl, VcrossQuat, Lvs, Svs, Lvq, Svq,
+    Mfv, Mtv, Vpfx, Viim, Vfim, Vh2f, Vf2h, Vf2i, Vi2f, Vx2i, VmidT, Vmmov, VfpuMatrixInit, Vidt, Vcst, Vocp, VfpuHorizontal, Vrot, Vtfm, VfpuVectorInit, VfpuVec3, Vscl, Vdot, Vhdp, Vcrs, Vdet, Vcmp, Vminmax, VfpuCompare3, Vcmov, VfpuUnary, Vmmul, Vmscl, VcrossQuat, Lvs, Svs, Lvq, Svq,
     Syscall,
     Vflush,
     Vfpu,
diff --git a/include/psprecomp/runtime.hpp b/include/psprecomp/runtime.hpp
index 7a51c91..15296a7 100644
--- a/include/psprecomp/runtime.hpp
+++ b/include/psprecomp/runtime.hpp
@@ -98,6 +98,10 @@ public:
     [[nodiscard]] const std::string &stop_reason() const noexcept;
 
     void unsupported(std::uint32_t pc, std::uint32_t instruction, const std::string &reason);
+    // A unit was entered at a PC that is not one of its entries (code only
+    // reached through a pointer the analysis never saw): hand it to the
+    // missing-code handler, or stop when none is installed.
+    void enter_untranslated(AllegrexContext &ctx);
     void arithmetic_overflow(std::uint32_t pc, std::uint32_t instruction);
     void invoke_import(std::string_view library, std::uint32_t nid, AllegrexContext &ctx);
     // Generated import wrappers have a stable numeric slot. Resolve the
diff --git a/src/decoder.cpp b/src/decoder.cpp
index 9a771bf..794c00f 100644
--- a/src/decoder.cpp
+++ b/src/decoder.cpp
@@ -243,6 +243,12 @@ DecodedInstruction decode_allegrex(std::uint32_t word) {
         } else if (operation == 4u) {
             d.kind = OpcodeKind::Vhdp;
             d.mnemonic = "vhdp";
+        } else if (operation == 5u) {
+            d.kind = OpcodeKind::Vcrs;
+            d.mnemonic = "vcrs";
+        } else if (operation == 6u) {
+            d.kind = OpcodeKind::Vdet;
+            d.mnemonic = "vdet";
         } else {
             d.kind = OpcodeKind::Vfpu;
             d.mnemonic = "vfpu1";
diff --git a/src/interpreter.cpp b/src/interpreter.cpp
index efc08c2..87d3798 100644
--- a/src/interpreter.cpp
+++ b/src/interpreter.cpp
@@ -508,6 +508,8 @@ bool execute(Runtime &rt, AllegrexContext &ctx, const DecodedInstruction &d, std
     }
     case K::Vdot: ctx.execute_vfpu_vdot(vd, vs, vt, length); break;
     case K::Vhdp: ctx.execute_vfpu_vhdp(vd, vs, vt, length); break;
+    case K::Vcrs: ctx.execute_vfpu_vcrs(vd, vs, vt); break;
+    case K::Vdet: ctx.execute_vfpu_vdet(vd, vs, vt); break;
     case K::VcrossQuat: ctx.execute_vfpu_cross_quat(vd, vs, vt, length); break;
     case K::Vminmax: ctx.execute_vfpu_vminmax(vd, vs, vt, length, ((w >> 23u) & 7u) == 3u); break;
     case K::VfpuCompare3: ctx.execute_vfpu_compare3(vd, vs, vt, length, (w >> 23u) & 7u); break;
diff --git a/src/runtime.cpp b/src/runtime.cpp
index 99778b3..35cee1e 100644
--- a/src/runtime.cpp
+++ b/src/runtime.cpp
@@ -1128,6 +1128,11 @@ void Runtime::unsupported(std::uint32_t pc, std::uint32_t instruction, const std
     stop("Unsupported Allegrex instruction " + hex32(instruction) + " at " + hex32(pc) + ": " + reason);
 }
 
+void Runtime::enter_untranslated(AllegrexContext &ctx) {
+    if (g_missing_code_handler != nullptr) g_missing_code_handler(*this, ctx);
+    else unsupported(ctx.pc, 0u, "invalid internal function entry");
+}
+
 void Runtime::arithmetic_overflow(std::uint32_t pc, std::uint32_t instruction) {
     stop("Allegrex arithmetic overflow for " + hex32(instruction) + " at " + hex32(pc));
 }
diff --git a/tools/codegen_main.cpp b/tools/codegen_main.cpp
index 93e6d66..2497407 100644
--- a/tools/codegen_main.cpp
+++ b/tools/codegen_main.cpp
@@ -616,6 +616,15 @@ std::string emit_regular(const psprecomp::DecodedInstruction &d, std::uint32_t p
             << target << "u, " << length << "u);\n";
         break;
     }
+    case psprecomp::OpcodeKind::Vcrs:
+    case psprecomp::OpcodeKind::Vdet: {
+        const std::uint32_t destination = d.word & 0x7Fu;
+        const std::uint32_t source = (d.word >> 8u) & 0x7Fu;
+        const std::uint32_t target = (d.word >> 16u) & 0x7Fu;
+        out << "    ctx.execute_vfpu_" << (d.kind == psprecomp::OpcodeKind::Vcrs ? "vcrs(" : "vdet(")
+            << destination << "u, " << source << "u, " << target << "u);\n";
+        break;
+    }
     case psprecomp::OpcodeKind::VcrossQuat: {
         const std::uint32_t size_code = ((d.word >> 7u) & 1u) | (((d.word >> 15u) & 1u) << 1u);
         const std::uint32_t length = size_code + 1u;
@@ -1043,7 +1052,7 @@ std::string emit_function_source(const GeneratedFunctionInput &function,
                  << psprecomp::hex32(label).substr(2) << ";\n";
         }
         body << "    default:\n"
-             << "        if (local_transfers == 0u) rt.unsupported(ctx.pc, 0u, \"invalid internal function entry\");\n"
+             << "        if (local_transfers == 0u) rt.enter_untranslated(ctx);\n"
              // Local transfers advance local_pc without touching AllegrexContext.
              // Leaving the unit through this default arm hands control back to the
              // outer dispatcher, for which ctx.pc is the only statement of where to
@@ -1067,7 +1076,7 @@ std::string emit_function_source(const GeneratedFunctionInput &function,
                  << psprecomp::hex32(label).substr(2) << ";\n";
         }
         body << "    default:\n"
-             << "        if (local_transfers == 0u) rt.unsupported(ctx.pc, 0u, \"invalid internal function entry\");\n"
+             << "        if (local_transfers == 0u) rt.enter_untranslated(ctx);\n"
              // Local transfers advance local_pc without touching AllegrexContext.
              // Leaving the unit through this default arm hands control back to the
              // outer dispatcher, for which ctx.pc is the only statement of where to
