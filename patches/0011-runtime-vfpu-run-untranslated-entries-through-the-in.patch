From a6aa73967832e51201b2708f78610255151336ad Mon Sep 17 00:00:00 2001
From: Felipe Negri <felipe.negri43@gmail.com>
Date: Thu, 26 Nov 2026 19:04:05 -0300
Subject: [PATCH] runtime, vfpu: run untranslated entries through the
 interpreter; vcrs and vdet

A jump into a translation unit at a PC that is not one of its entries
(static constructors in Dante's Inferno sit in .data and are only reached
through the constructor table) used to stop with "invalid internal
function entry". The unit now hands it to the missing-code handler, which
the web profile points at the interpreter.

Also decode and lower vcrs.t (half cross product) and vdet.p.
---
 include/psprecomp/allegrex_context.hpp | 24 ++++++++++++++++++++++++
 include/psprecomp/decoder.hpp          |  2 +-
 include/psprecomp/runtime.hpp          |  4 ++++
 src/decoder.cpp                        |  6 ++++++
 src/interpreter.cpp                    |  2 ++
 src/runtime.cpp                        |  5 +++++
 tools/codegen_main.cpp                 | 13 +++++++++++--
 7 files changed, 53 insertions(+), 3 deletions(-)

diff --git a/include/psprecomp/allegrex_context.hpp b/include/psprecomp/allegrex_context.hpp
index 4a63278..e5c74d8 100644
--- a/include/psprecomp/allegrex_context.hpp
+++ b/include/psprecomp/allegrex_context.hpp
@@ -836,6 +836,30 @@ struct alignas(16) AllegrexContext {
         return std::bit_cast<std::uint32_t>(selected);
     }
 
+    // VCRS.T is the half cross product (s.y*t.z, s.z*t.x, s.x*t.y); VDET.P
+    // the 2x2 determinant s.x*t.y - s.y*t.x.  Both read prefixed sources.
+    void execute_vfpu_vcrs(std::uint32_t destination_register, std::uint32_t source_register,
+                           std::uint32_t target_register) noexcept {
+        float source[4]{}, target[4]{};
+        read_vfpu_vector(source, source_register, 3u);
+        read_vfpu_vector(target, target_register, 3u);
+        apply_vfpu_source_prefix(source, 3u, 0u);
+        apply_vfpu_source_prefix(target, 3u, 1u);
+        const float result[4]{source[1] * target[2], source[2] * target[0], source[0] * target[1], 0.0f};
+        write_vfpu_vector_with_destination_prefix(result, destination_register, 3u);
+    }
+
+    void execute_vfpu_vdet(std::uint32_t destination_scalar_register, std::uint32_t source_register,
+                           std::uint32_t target_register) noexcept {
+        float source[4]{}, target[4]{};
+        read_vfpu_vector(source, source_register, 2u);
+        read_vfpu_vector(target, target_register, 2u);
+        apply_vfpu_source_prefix(source, 2u, 0u);
+        apply_vfpu_source_prefix(target, 2u, 1u);
+        const float result[1]{source[0] * target[1] - source[1] * target[0]};
+        write_vfpu_vector_with_destination_prefix(result, destination_scalar_register, 1u);
+    }
+
     void execute_vfpu_cross_quat(std::uint32_t destination_register,
                                  std::uint32_t source_register, std::uint32_t target_register,
                                  std::uint32_t length) noexcept {
