From 8c409519aa67803f25b921265eadb39fd3690544 Mon Sep 17 00:00:00 2001
From: Felipe Negri <felipe-negri@users.noreply.github.com>
Date: Fri, 27 Nov 2026 20:19:07 -0300
Subject: [PATCH 12/13] elf: find the module info of an executable without
 section headers

Some PSN executables (Tekken 6) carry no section headers. As on the PSP,
the first loadable segment's paddr is then the file offset of the module
info.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/elf32.cpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/elf32.cpp b/src/elf32.cpp
index 92585ef..5cbe385 100644
--- a/src/elf32.cpp
+++ b/src/elf32.cpp
@@ -326,8 +326,20 @@ std::optional<PspModuleInfo> Elf32Image::find_module_info(const GuestMemory &mem
     const auto section_it = std::find_if(sections_.begin(), sections_.end(), [](const ElfSection &section) {
         return section.name == ".rodata.sceModuleInfo" || section.name == ".sceModuleInfo";
     });
-    if (section_it == sections_.end() || section_it->size < sizeof(ModuleInfo32)) return std::nullopt;
-    const std::uint32_t addr = section_runtime_address(*section_it, load_base);
+    std::uint32_t addr = 0;
+    if (section_it != sections_.end() && section_it->size >= sizeof(ModuleInfo32)) {
+        addr = section_runtime_address(*section_it, load_base);
+    } else {
+        // No section headers (some PSN executables, e.g. Tekken 6): as on the
+        // PSP, the first segment's paddr is the file offset of the module info.
+        const auto segment_it = std::find_if(segments_.begin(), segments_.end(),
+                                             [](const ElfSegment &segment) { return segment.type == 1u; });
+        if (segment_it == segments_.end()) return std::nullopt;
+        const std::uint32_t offset = segment_it->paddr & 0x7FFFFFFFu;
+        if (offset < segment_it->offset || offset - segment_it->offset >= segment_it->file_size) return std::nullopt;
+        addr = segment_runtime_address(static_cast<std::size_t>(segment_it - segments_.begin()), load_base) +
+               (offset - segment_it->offset);
+    }
     if (!memory.contains(addr, sizeof(ModuleInfo32))) return std::nullopt;
 
     char name[28]{};
